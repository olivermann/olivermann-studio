---
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = {
  'Strategy & Leadership': [
    'Strategic Marketing & Communications',
    'Integrated Campaign Strategy',
    'People Management & Mentorship',
    'Project Management (Asana)',
    'Event Management',
    'Budget Planning',
    'Sponsorships',
    'Media Relations',
    'Community Engagement',
    'Stakeholder Relations',
  ],
  'Storytelling & Content': [
    'Editorial Strategy & Storytelling',
    'Content Marketing',
    'Copywriting',
    'Videography',
    'Photography',
    'Podcasting',
    'Graphic Design',
    'Adobe Creative Cloud',
  ],
  'Digital & Analytics': [
    'Email Marketing',
    'Social Media Strategy',
    'Digital Analytics & Reporting',
    'AI Tools & Workflow Automation',
    'Website Management',
    'SEO',
    'Paid Advertising',
  ],
};
---

<BaseLayout
  title="Resume · Oliver Mann Studio"
  description="Resume of Oliver Mann: 15 years leading marketing, communications, and events at the University of British Columbia."
  active="resume"
>
<main>
  <h1>Resume</h1>

  <!-- 7.2 Experience -->
  <section class="fade-in">
    <h2>Experience</h2>

    <div class="role">
      <h3>Senior Manager, Marketing &amp; Events</h3>
      <p class="org">Innovation UBC, VP Research &amp; Innovation, UBC · Dec 2025 – Present</p>
      <ul>
        <li>Direct a four-person marketing team, providing project management, coaching, and feedback. Built a high-performing team in three months and immediately delivered two of our largest annual events. Managed 125+ projects in Asana in 2026, exceeding all digital, storytelling, and event targets.</li>
        <li>Manage all digital channels, including website, email marketing, and social media. Grew website users 52% YoY to 38,000+, launched monthly newsletters (38.5% open rate), cut email costs 50%, and drove 3.1x LinkedIn and 5.5x Instagram engagement.</li>
        <li>Lead integrated marketing strategy for priority initiatives and programs, including launching UBC’s updated Express License Agreement (ELA) and recruiting for Lab2Market and Venture Founder. ELA agreements up 87%, Lab2Market applications up 40%, Venture Founder traffic up 17% YoY.</li>
        <li>Manage annual marketing budget, including event budgets and wages for hourly employees. Approve pay, track hours, process all team invoices through finance, and monitor expenses and report variances to stay on budget.</li>
        <li>Drive editorial strategy and multimedia storytelling that builds awareness of Innovation UBC and showcases UBC’s portfolio of companies. Helped the team publish 28 stories in Q3 (nearly 3x target) while personally writing the five most-viewed website stories of 2026.</li>
        <li>Plan and execute flagship events, including the Investor and Venture Showcases. Grew Investor Showcase registrations 28% to 600, attracting 203 registered investors and funders from 130+ organizations and earning a Net Promoter Score of 88.</li>
        <li>Own marketing analytics and reporting across web, email, social, events, and campaigns. Built live Data Studio dashboards and executive reports from the ground up, now feeding funding reports and requests and guiding budget decisions, such as avoiding a $5K low-ROI partnership.</li>
</ul>
    </div>

    <div class="role">
      <h3>Senior Communications Strategist</h3>
      <p class="org">Office of Community Engagement, VP External Relations, UBC · Feb 2022 – Nov 2025</p>
      <ul>
        <li>Led communications strategy that elevated the office's profile and increased awareness, participation, and diversity across programs. Drove a 53% increase in applications to its largest funding program, with 78% of funded projects now representing new partnerships.</li>
        <li>Managed all aspects of digital channels, including website, email marketing, and social media. Achieved 80% annual traffic growth and tripled newsletter and social media audiences, with analytics tracking and KPIs developed to measure ROI and inform decisions.</li>
        <li>Planned and executed high-profile events, including UBC Connects and UBC Partnering in Research, managing all event communications and promotion. Drove 2,500+ event registrations in 2024, with participants from Canada, the U.S., and Australia.</li>
        <li>Led multimedia storytelling across written stories, video, photography, and podcasts to highlight diverse community-university partnerships. Published 24 institutional stories in 2024, 15 featured on UBC's largest channels, driving 150,000+ users to program pages.</li>
        <li>Supervised and mentored direct reports while providing strategic communications leadership across UBC Vancouver, Okanagan, and external partners. Advised leadership and trained staff on communications strategy, reciprocal storytelling, and emerging AI trends.</li>
      </ul>
    </div>

    <div class="role">
      <h3>Digital Marketing Strategist</h3>
      <p class="org">Faculty of Arts, UBC · Jun 2019 – Feb 2022</p>
      <ul>
        <li>Developed and executed data-driven digital marketing and brand campaigns, integrating multi-channel engagement, paid advertising, and retargeting to strengthen the faculty's reputation across 25+ departments. Supported COVID-19 crisis communications with rapid-response messaging and digital content for students and stakeholders.</li>
        <li>Managed social media strategy across Instagram, Twitter, Facebook, and YouTube, producing 100+ posts weekly. Achieved a 200% increase in quarterly engagement (2019 to 2020), grew followers 30% annually, and averaged 100K+ organic impressions per month.</li>
        <li>Led multimedia storytelling that supported institutional priorities and enhanced the student experience through blogs, videos, photos, and Instagram takeovers. Produced the faculty's highest-performing story of 2021, responding to rising anti-Asian hate across North America.</li>
        <li>Revamped data analytics for the faculty, improving performance tracking across web, email, social, and digital campaigns. Delivered monthly and quarterly reports in Google Analytics and Data Studio, giving leadership and communicators actionable insights to improve strategy and engagement.</li>
      </ul>
    </div>

    <div class="role">
      <h3>Communications and Events Manager</h3>
      <p class="org">Department of Asian Studies, UBC · Sep 2012 – May 2019</p>
      <ul>
        <li>Developed and implemented the department's strategic communications plan, aligning messaging with organizational priorities. Managed website, email marketing, and social media content to expand audience engagement and elevate the department's reputation.</li>
        <li>Managed, hired, and evaluated a team of three, overseeing content production, brand consistency, and workflow. Developed guidelines and processes that improved collaboration and efficiency across digital and print platforms.</li>
        <li>Led event planning and promotion for lectures, conferences, student and alumni events, and cultural celebrations, overseeing budgets, logistics, and marketing. Managed events of 150 to 500 attendees with consistently sold-out results.</li>
        <li>Produced digital storytelling, including feature stories, interviews, videos, and press releases that highlighted faculty research and student experiences. Managed media requests and collaborated with scholars, students, and alumni to tell stories that advanced the department's mission.</li>
      </ul>
    </div>
  </section>

  <!-- 7.3 Education -->
  <section class="fade-in">
    <h2>Education</h2>
    <div class="edu">
      <h3>Master of Arts, Professional Communications</h3>
      <p class="where">Royal Roads University, Victoria, BC</p>
      <p>Published research: examines how Canada's largest universities can use communications and storytelling to advance truth and reconciliation and strengthen relationships with Indigenous partners.</p>
      <p>Areas of study: Organizational Communications, Political Communications, Conflict Analysis &amp; Management, Communications Theory, Research Methodology.</p>
    </div>
    <div class="edu">
      <h3>Certificate in Digital Content &amp; Communications</h3>
      <p class="where">University of British Columbia, Vancouver, BC</p>
    </div>
    <div class="edu">
      <h3>Bachelor of Arts, Asian Studies &amp; Economics</h3>
      <p class="where">University of British Columbia, Vancouver, BC</p>
    </div>
  </section>

  <!-- 7.4 Skills -->
  <section class="fade-in">
    <h2>Skills</h2>
    {Object.entries(skills).map(([group, list]) => (
      <div class="skill-group">
        <h3>{group}</h3>
        <div class="pills">
          {list.map((s) => <span>{s}</span>)}
        </div>
      </div>
    ))}
  </section>
</main>
</BaseLayout>

<style>
  main { max-width: 860px; margin: 0 auto; padding: 0 clamp(24px, 6vw, 80px); }
  h1 { font-weight: 800; font-size: clamp(32px, 4.6vw, 46px); letter-spacing: -0.02em; text-align: center; margin-top: clamp(28px, 6vh, 56px); }
  section { margin-top: clamp(48px, 8vh, 72px); }
  h2 { font-weight: 800; font-size: clamp(22px, 2.8vw, 28px); letter-spacing: -0.02em; margin-bottom: 28px; }

  .role { padding: 22px 0; }
  .role h3 { font-weight: 700; font-size: 19px; letter-spacing: -0.01em; }
  .role .org { margin-top: 4px; font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .role ul { margin: 16px 0 0 18px; }
  .role li { font-size: 14.5px; color: #3a3a3a; line-height: 1.7; margin-bottom: 10px; }
  .role .pending { margin-top: 12px; font-size: 13.5px; font-style: italic; color: var(--muted); }

  .edu { padding: 16px 0; }
  .edu h3 { font-weight: 700; font-size: 16.5px; }
  .edu .where { margin-top: 4px; font-size: 13px; color: var(--muted); }
  .edu p { margin-top: 10px; font-size: 14px; color: #3a3a3a; line-height: 1.65; }

  .skill-group { margin-bottom: 30px; }
  .skill-group h3 { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
</style>
