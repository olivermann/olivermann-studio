---
import { getCollection } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Lightbox from '../components/Lightbox.astro';

// Gallery is driven by src/data/photos.yaml (validated by the photos collection
// schema). Image files live in src/assets/photos/ so Astro optimizes them.
const entries = await getCollection('photos');
const photos = entries
  .map((e) => e.data)
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

function resolvePhoto(src: string): ImageMetadata {
  const hit = Object.entries(files).find(([path]) => path.endsWith(`/${src}`));
  if (!hit) {
    throw new Error(
      `photos.yaml references "${src}" but no such file exists in src/assets/photos/`
    );
  }
  return hit[1].default;
}

// Pre-render a large version of each photo for the lightbox.
const gallery = await Promise.all(
  photos.map(async (p) => {
    const meta = resolvePhoto(p.src);
    const large = await getImage({ src: meta, width: 1600 });
    return { ...p, meta, largeSrc: large.src };
  })
);
---

<BaseLayout
  title="Photography · Oliver Mann"
  description="Portrait and event photography by Oliver Mann, a Vancouver-based photographer."
  active="photography"
>

<section class="intro">
  <h1>Photography</h1>
  <p>I bought my first DSLR, a Canon T3i, to take photos of my band's first tour across Western Canada. When I stopped playing music, I channeled all my creativity into photography. I started by shooting family and friends, loved the bold creativity of fashion, and made a niche in male portraiture. These days, I shoot on a Sony a7 IV. Photos are the new headlines, and I use my photography to make my marketing and storytelling stronger.</p>
  <p>Open to freelance portrait and event photography. <a href="mailto:hello@olivermann.studio">Get in touch</a>.</p>
</section>

<section class="press" aria-label="Featured in">
  <div class="press-inner">
    <p class="source">Daily Hive: 9 Talented Portrait Photographers to Follow on Instagram in Vancouver</p>
    <p class="source">Narcity: 14 Incredible Vancouver Photographers You Need to Follow Right Now</p>
  </div>
</section>

<div class="filters centered" role="tablist" aria-label="Filter photos">
  <button class="active" data-filter="all" role="tab" aria-selected="true">All</button>
  <button data-filter="portrait" role="tab" aria-selected="false">Portraits</button>
  <button data-filter="event" role="tab" aria-selected="false">Events</button>
</div>

<div class="grid" id="grid">
  {gallery.map((p, i) => (
    <figure
      class="fade-in"
      data-category={p.category}
      data-index={i}
      data-large={p.largeSrc}
      data-alt={p.alt}
      data-caption={p.caption}
      data-album={p.flickrAlbum}
    >
      <Image
        src={p.meta}
        alt={p.alt}
        widths={[480, 800, 1200]}
        sizes="(max-width: 560px) 92vw, (max-width: 900px) 46vw, 420px"
        loading={i < 6 ? 'eager' : 'lazy'}
      />
    </figure>
  ))}
</div>

<Lightbox />
</BaseLayout>

<style>
  /* Intro matches the Blog page intro (blog/index.astro): centered, 14.5px, muted, same 900px content column. */
  .intro { max-width: 900px; margin: clamp(24px, 5vh, 44px) auto 0; padding: 0 clamp(24px, 6vw, 80px); text-align: center; }
  .intro h1 { font-weight: 800; font-size: clamp(32px, 4.6vw, 46px); letter-spacing: -0.02em; }
  .intro p { margin-top: 14px; font-size: 14.5px; color: var(--muted); }
  .intro a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }

  /* Feature lines match the intro text: centered, 14.5px, muted, same 900px column. */
  .press { max-width: 900px; margin: 14px auto 0; padding: 0 clamp(24px, 6vw, 80px); text-align: center; }
  .press p { margin-top: 6px; font-size: 14.5px; color: var(--muted); }

  .filters { justify-content: center; gap: clamp(20px, 4vw, 44px); margin: 20px 0 32px; }

  .grid { columns: 3; column-gap: 28px; padding: 0 clamp(24px, 6vw, 80px); max-width: 1400px; margin: 0 auto; }
  @media (max-width: 900px) { .grid { columns: 2; column-gap: 20px; } }
  @media (max-width: 560px) { .grid { columns: 1; } }
  .grid figure { break-inside: avoid; margin: 0 0 28px; cursor: zoom-in; position: relative; overflow: hidden; }
  .grid figure :global(img) { width: 100%; height: auto; display: block; transition: transform 0.4s ease, opacity 0.4s ease; }
  .grid figure:hover :global(img) { transform: scale(1.015); }
  .grid figure.hidden { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .grid figure:hover :global(img) { transform: none; }
  }
</style>

<script>
  const figures = Array.from(document.querySelectorAll<HTMLElement>('.grid figure'));
  const lb = (window as any).omLightbox;

  lb.setItems(
    figures.map((f) => ({
      src: f.dataset.large!,
      alt: f.dataset.alt || '',
      caption: f.dataset.caption || undefined,
      album: f.dataset.album || undefined,
    }))
  );

  let currentFilter = 'all';
  const visibleIndices = () =>
    figures
      .filter((f) => currentFilter === 'all' || f.dataset.category === currentFilter)
      .map((f) => Number(f.dataset.index));

  figures.forEach((f) => {
    f.addEventListener('click', () => lb.open(Number(f.dataset.index), visibleIndices()));
  });

  document.querySelectorAll<HTMLButtonElement>('.filters button').forEach((btn) => {
    btn.addEventListener('click', () => {
      currentFilter = btn.dataset.filter!;
      document.querySelectorAll('.filters button').forEach((b) => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-selected', b === btn ? 'true' : 'false');
      });
      figures.forEach((f) => {
        f.classList.toggle(
          'hidden',
          currentFilter !== 'all' && f.dataset.category !== currentFilter
        );
      });
    });
  });
</script>
