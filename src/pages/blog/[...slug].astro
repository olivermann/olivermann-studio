---
import { render } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getPublishedPosts, tagLabel, longDate, isExternal } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  // Posts with externalLink set link directly out: no page is generated for them.
  return posts
    .filter((p) => !isExternal(p))
    .map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const ogImage = d.heroImage
  ? new URL((await getImage({ src: d.heroImage, width: 1200 })).src, Astro.site).href
  : undefined;

const byline = ['Oliver Mann', d.role, longDate(d.date)].filter(Boolean).join(' · ');
---

<BaseLayout
  title={`${d.title} · Oliver Mann`}
  description={d.excerpt}
  active="blog"
  ogImage={ogImage}
  ogType="article"
>

<div class="hero-media">
  {
    d.heroImage ? (
      <Image
        src={d.heroImage}
        alt={d.heroImageAlt ?? ''}
        widths={[720, 1000, 1600]}
        sizes="(max-width: 1000px) 100vw, 1000px"
        loading="eager"
      />
    ) : d.heroVideoId ? (
      <div class="video-frame">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${d.heroVideoId}`}
          title={d.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      </div>
    ) : (
      <div class="hero-placeholder">Hero image to come</div>
    )
  }
</div>

<article>
  <div class="post-head">
    <p class="kicker">{tagLabel(post)}</p>
    <h1>{d.title}</h1>
    <p class="dek">{d.excerpt}</p>
    <p class="byline">{byline}</p>
  </div>

  <div class="body post-body">
    <Content />
  </div>

  {d.skillsTags.length > 0 && (
    <div class="skills">
      <h2>Skills Demonstrated</h2>
      <div class="pills">
        {d.skillsTags.map((s) => <span>{s}</span>)}
      </div>
    </div>
  )}

  <a class="back" href="/blog/">&larr; All posts</a>
</article>

<Lightbox />
</BaseLayout>

<style is:global>
  article { max-width: 720px; margin: 0 auto; padding: 0 clamp(24px, 6vw, 80px); }
  .hero-media { max-width: 1000px; margin: clamp(20px, 4vh, 40px) auto 0; padding: 0 clamp(24px, 6vw, 80px); }
  .hero-media img { width: 100%; height: auto; display: block; }
  .video-frame { aspect-ratio: 16 / 9; }
  .video-frame iframe { width: 100%; height: 100%; border: 0; display: block; }
  .hero-placeholder { aspect-ratio: 16 / 8; background: var(--ph); display: flex; align-items: center; justify-content: center; color: var(--ph-text); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
  .post-head { text-align: center; margin-top: clamp(28px, 5vh, 48px); }
  .post-head .kicker { font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  article h1 { font-weight: 800; font-size: clamp(28px, 4.2vw, 42px); line-height: 1.15; letter-spacing: -0.02em; margin-top: 14px; }
  .dek { margin-top: 16px; font-size: 17px; color: var(--muted); line-height: 1.7; max-width: 560px; margin-left: auto; margin-right: auto; }
  .byline { margin-top: 20px; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }

  .body { margin-top: clamp(36px, 6vh, 56px); }
  .body h2 { font-weight: 800; font-size: 20px; letter-spacing: -0.01em; margin: 36px 0 12px; }
  .body p, .body li { font-size: 16px; line-height: 1.8; color: #2e2e2e; }
  .body ul, .body ol { margin: 0 0 0 20px; }
  .body li { margin-bottom: 8px; }
  .body em { color: var(--muted); }
  .body img { max-width: 100%; height: auto; display: block; margin: 28px 0; cursor: zoom-in; }
  .body blockquote { border-left: 3px solid var(--text); padding-left: 20px; margin: 28px 0; }
  .body iframe { max-width: 100%; margin: 28px 0; border: 0; }

  .screens { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 28px 0; }
  @media (max-width: 560px) { .screens { grid-template-columns: 1fr; } }
  .screens > div { aspect-ratio: 16 / 10; background: var(--ph); display: flex; align-items: center; justify-content: center; color: var(--ph-text); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; text-align: center; padding: 12px; }

  .skills { margin-top: 44px; padding-top: 26px; border-top: 1px solid var(--line); }
  .skills h2 { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
  .back { display: inline-block; margin-top: 44px; font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; }
</style>

<script>
  // Open post body images in the shared lightbox. Body images are plain
  // Markdown, so this wires them up without any component syntax in posts.
  const imgs = Array.from(document.querySelectorAll<HTMLImageElement>('.post-body img'));
  if (imgs.length) {
    const lb = (window as any).omLightbox;
    const items = imgs.map((img) => ({ src: img.currentSrc || img.src, alt: img.alt }));
    imgs.forEach((img, i) => {
      img.addEventListener('click', () => {
        lb.setItems(imgs.map((im) => ({ src: im.currentSrc || im.src, alt: im.alt })));
        lb.open(i);
      });
    });
    void items;
  }
</script>
