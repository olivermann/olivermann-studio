---
import { render } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getPublishedPosts, tagLabel, longDate, isExternal } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  // Posts with externalLink set link directly out: no page is generated for them.
  return posts
    .filter((p) => !isExternal(p))
    .map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const ogImage = d.heroImage
  ? new URL((await getImage({ src: d.heroImage, width: 1200 })).src, Astro.site).href
  : undefined;

const byline = ['Oliver Mann', d.role, longDate(d.date)].filter(Boolean).join(' · ');
---

<BaseLayout
  title={`${d.title} · Oliver Mann Studio`}
  description={d.excerpt}
  active="blog"
  ogImage={ogImage}
  ogType="article"
>

<div class="hero-media">
  {
    d.heroImage ? (
      <Image
        src={d.heroImage}
        alt={d.heroImageAlt ?? ''}
        widths={[720, 1000, 1600]}
        sizes="(max-width: 1000px) 100vw, 1000px"
        loading="eager"
      />
    ) : d.heroVideoId ? (
      <div class="video-frame">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${d.heroVideoId}`}
          title={d.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      </div>
    ) : (
      <div class="hero-placeholder">Hero image to come</div>
    )
  }
  {d.heroCaption && <p class="hero-caption" set:html={d.heroCaption} />}
</div>

<article>
  <div class="post-head">
    <p class="kicker">{tagLabel(post)}</p>
    <h1>{d.title}</h1>
    <p class="dek">{d.excerpt}</p>
    <p class="byline">{byline}</p>
  </div>

  <div class="body post-body">
    <Content />
  </div>

  {d.originalUrl && (
    <div class="origin-note">
      <p>
        {d.originalHideDate ? 'This page' : 'This story'} was originally published on{' '}
        <a href={d.originalUrl}>{d.originalSite ?? new URL(d.originalUrl).hostname}</a>{d.originalHideDate ? '.' : ` on ${longDate(d.date)}.`}
      </p>
    </div>
  )}

  {d.skillsTags.length > 0 && (
    <div class="skills">
      <h2>Skills Demonstrated</h2>
      <div class="pills">
        {d.skillsTags.map((s) => <span>{s}</span>)}
      </div>
    </div>
  )}

  <a class="back" href="/blog/">&larr; All posts</a>
</article>

<Lightbox />
</BaseLayout>

<style is:global>
  article { max-width: 720px; margin: 0 auto; padding: 0 clamp(24px, 6vw, 80px); }
  .hero-media { max-width: 1000px; margin: clamp(20px, 4vh, 40px) auto 0; padding: 0 clamp(24px, 6vw, 80px); }
  .hero-media img { width: 100%; height: auto; display: block; }
  .hero-caption a { text-decoration: underline; text-underline-offset: 3px; }
  .hero-caption { margin-top: 10px; font-size: 13px; line-height: 1.5; color: var(--muted); }
  .video-frame { aspect-ratio: 16 / 9; }
  .video-frame iframe { width: 100%; height: 100%; border: 0; display: block; }
  .hero-placeholder { aspect-ratio: 16 / 8; background: var(--ph); display: flex; align-items: center; justify-content: center; color: var(--ph-text); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; }
  .post-head { text-align: center; margin-top: clamp(28px, 5vh, 48px); }
  .post-head .kicker { font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  article h1 { font-weight: 800; font-size: clamp(28px, 4.2vw, 42px); line-height: 1.15; letter-spacing: -0.02em; margin-top: 14px; }
  .dek { margin-top: 16px; font-size: 17px; color: var(--muted); line-height: 1.7; max-width: 560px; margin-left: auto; margin-right: auto; }
  .byline { margin-top: 20px; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }

  .body { margin-top: clamp(36px, 6vh, 56px); }
  .body h2 { font-weight: 800; font-size: 20px; letter-spacing: -0.01em; margin: 36px 0 12px; }
  .body p, .body li { font-size: 16px; line-height: 1.8; color: #2e2e2e; }
  .body p + p { margin-top: 16px; }
  .body p + ul, .body p + ol { margin-top: 12px; }
  .body ul, .body ol { margin: 0 0 0 20px; }
  .body ul + p, .body ol + p { margin-top: 16px; }
  .body li { margin-bottom: 8px; }
  .body em { color: var(--muted); }
  .body img { max-width: 100%; height: auto; display: block; margin: 28px 0; cursor: zoom-in; }
  .body blockquote { border-left: 3px solid var(--text); padding-left: 20px; margin: 28px 0; }
  .body blockquote p { font-size: 17px; font-style: italic; }
  .body blockquote cite { display: block; margin-top: 12px; font-style: normal; font-size: 14px; color: var(--muted); }
  .body iframe { max-width: 100%; margin: 28px 0; border: 0; }

  .screens { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin: 28px 0; }
  @media (max-width: 560px) { .screens { grid-template-columns: 1fr; } }
  .screens > div { aspect-ratio: 16 / 10; background: var(--ph); display: flex; align-items: center; justify-content: center; color: var(--ph-text); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; text-align: center; padding: 12px; }

  .body iframe { border-radius: 12px; }
  .body a { text-decoration: underline; text-underline-offset: 3px; }
  .body a.pdf-button { display: inline-block; margin: 28px 0 8px; padding: 14px 26px; background: var(--text); color: #fff; font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none; border-radius: 2px; }
  .body a.pdf-button:hover { opacity: 0.85; }
  .body .pdf-meta { display: block; font-size: 13px; color: var(--muted); }
  .origin-note { margin-top: 36px; }
  .origin-note p { background: #F5F5F5; border-left: 3px solid var(--text); padding: 12px 16px; font-size: 14px; line-height: 1.6; color: #2e2e2e; }
  .origin-note a { text-decoration: underline; text-underline-offset: 3px; }

  .skills { margin-top: 44px; padding-top: 26px; border-top: 1px solid var(--line); }
  .skills h2 { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
  .back { display: inline-block; margin-top: 44px; font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; }

  /* ---------- Long research posts (wrap the post body in <div class="long-post">) ----------
     Used by the thesis recommendations post: bigger section headings, a note box, jump links,
     an exact-extract section with sub-headings, and a summary table. Scoped so other posts are unaffected. */
  html:has(.long-post) { scroll-behavior: smooth; }
  .body .long-post h2 { font-weight: 800; font-size: 24px; line-height: 1.25; letter-spacing: -0.015em; margin: 64px 0 12px; scroll-margin-top: 24px; }
  .body .long-post > h2:first-child { margin-top: 0; }
  .body .long-post h3 { font-weight: 800; font-size: 17px; line-height: 1.35; letter-spacing: -0.005em; margin: 32px 0 10px; scroll-margin-top: 24px; }
  .body .long-post p + ul { margin-top: 16px; }
  .body .long-post li { margin-bottom: 14px; }
  .body .long-post li > p + p { margin-top: 12px; }
  .body .long-post strong { color: var(--text); font-weight: 700; }

  .body .long-post .note { margin-top: 28px; }
  .body .long-post .note p { background: #F5F5F5; border-left: 3px solid var(--text); padding: 14px 18px; font-size: 15px; line-height: 1.65; color: #2e2e2e; }
  .body .long-post .note p strong { display: block; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 4px; }

  .long-post .jump { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: baseline; }
  .long-post .jump-label { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .body .long-post .jump a { font-size: 13.5px; font-weight: 500; }

  .body .long-post .extract-section > h2:first-child { margin-top: 64px; }
  .body .long-post .extract-section h3 { border-top: 1px solid var(--line); padding-top: 30px; margin-top: 44px; }
  .body .long-post .extract-section h3:first-of-type { border-top: none; padding-top: 0; margin-top: 28px; }
  .body .long-post p.extract-label { font-size: 11px; font-weight: 700; line-height: 1.5; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin: 0 0 4px; }

  .long-post .table-wrap { margin-top: 64px; }
  .long-post table.summary { width: 100%; border-collapse: collapse; margin-top: 4px; }
  .long-post table.summary caption { text-align: left; padding-bottom: 14px; }
  .long-post .t-label { display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .long-post .t-title { display: block; font-weight: 800; font-size: 22px; letter-spacing: -0.015em; margin-top: 2px; }
  .long-post table.summary tr { border-top: 1px solid var(--line); }
  .long-post table.summary tr:first-child { border-top: 2px solid var(--text); }
  .long-post table.summary tr:last-child { border-bottom: 2px solid var(--text); }
  .long-post table.summary th[scope="row"] { text-align: left; vertical-align: top; width: 34%; padding: 20px 24px 20px 0; font-weight: 700; font-size: 14.5px; line-height: 1.5; }
  .long-post table.summary td { vertical-align: top; padding: 14px 0 6px; }
  .long-post table.summary td ul { list-style: none; margin: 0; }
  .body .long-post table.summary li { font-size: 15px; line-height: 1.55; margin: 0; padding: 7px 0 9px; border-top: 1px solid var(--line); }
  .body .long-post table.summary li:first-child { border-top: none; padding-top: 6px; }
  @media (max-width: 640px) {
    .long-post table.summary, .long-post table.summary tbody, .long-post table.summary tr, .long-post table.summary th, .long-post table.summary td { display: block; width: 100%; }
    .long-post table.summary th[scope="row"] { width: 100%; padding: 18px 0 2px; }
    .long-post table.summary td { padding: 4px 0 14px; }
  }

  /* ---------- Prompt blocks and screenshots (any post: fenced code blocks and Markdown images) ----------
     A fenced code block (```text) is wrapped by the script below in a "Prompt" bar with a Copy button.
     The !important rules override the inline colours the code highlighter adds. */
  .body .code-block { margin: 20px 0 28px; border: 1px solid var(--line); border-left: 3px solid var(--text); background: #F5F5F5; }
  .body .code-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 8px 10px 8px 18px; border-bottom: 1px solid var(--line); }
  .body .code-label { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .body .copy-btn { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; padding: 8px 16px; min-width: 84px; background: var(--text); color: #fff; border: 1px solid var(--text); border-radius: 2px; cursor: pointer; }
  .body .copy-btn:hover { opacity: 0.85; }
  .body .copy-btn:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; }
  .body .copy-btn.copied { background: #fff; color: var(--text); }
  .body .code-block pre { margin: 0; padding: 18px 20px 20px; white-space: pre-wrap !important; overflow-wrap: anywhere; overflow: visible !important; font-family: var(--sans); font-size: 14.5px; line-height: 1.7; background: transparent !important; color: #1a1a1a !important; }
  .body .code-block pre code, .body .code-block pre span { font: inherit; background: none; padding: 0; color: inherit !important; }
  .body .long-post img { border: 1px solid var(--line); }
  /* Tall, narrow screenshot (a list down the left side of a page): keep it from stretching to full width. */
  .body .long-post img[src*="website-folder-on-github"] { max-width: 320px; }
</style>

<script>
  // Open post body images in the shared lightbox. Body images are plain
  // Markdown, so this wires them up without any component syntax in posts.
  const imgs = Array.from(document.querySelectorAll<HTMLImageElement>('.post-body img'));
  if (imgs.length) {
    const lb = (window as any).omLightbox;
    const items = imgs.map((img) => ({ src: img.currentSrc || img.src, alt: img.alt }));
    imgs.forEach((img, i) => {
      img.addEventListener('click', () => {
        lb.setItems(imgs.map((im) => ({ src: im.currentSrc || im.src, alt: im.alt })));
        lb.open(i);
      });
    });
    void items;
  }

  // Prompt blocks: every fenced code block in a post body gets a "Prompt" bar and a Copy button.
  // Posts stay plain Markdown (a ```text block); this script does the rest.
  document.querySelectorAll<HTMLPreElement>('.post-body pre').forEach((pre) => {
    const wrap = document.createElement('div');
    wrap.className = 'code-block';
    const bar = document.createElement('div');
    bar.className = 'code-bar';
    const label = document.createElement('span');
    label.className = 'code-label';
    label.textContent = 'Prompt';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy this prompt as plain text');
    bar.appendChild(label);
    bar.appendChild(btn);
    pre.parentNode?.insertBefore(wrap, pre);
    wrap.appendChild(bar);
    wrap.appendChild(pre);

    const done = (ok: boolean) => {
      btn.textContent = ok ? 'Copied' : 'Press Ctrl+C';
      btn.classList.toggle('copied', ok);
      setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('copied'); }, 2000);
    };
    const fallback = (text: string) => {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch (e) { /* ignore */ }
      document.body.removeChild(ta);
      if (!ok) {
        const r = document.createRange();
        r.selectNodeContents(pre);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(r);
      }
      done(ok);
    };
    btn.addEventListener('click', () => {
      const text = pre.innerText.replace(/\s+$/, '');
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(() => done(true), () => fallback(text));
      } else {
        fallback(text);
      }
    });
  });
</script>
