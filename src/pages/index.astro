---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostThumb from '../components/PostThumb.astro';
import {
  getPublishedPosts,
  featuredPosts,
  storytellingPosts,
  researchRowPosts,
  speakingPosts,
  postHref,
  isExternal,
  shortDate,
  longDate,
  TYPE_LABELS,
} from '../lib/posts';

const posts = await getPublishedPosts();

// 5.2 Featured Case Studies: the four newest posts with featured: true. Newest = big slot, the next three = stacked rows.
const featured = featuredPosts(posts);
const featuredBig = featured[0];
const featuredRows = featured.slice(1);

// 5.3 Storytelling: writing/video/podcast posts; latest 6 per filter (client-side cap).
const stories = storytellingPosts(posts);

// 5.4 Research & Indigenous Engagement.
const RESEARCH_BIG_ID = 'ethical-storytelling-ma-research';
const researchBig = posts.find((p) => p.id === RESEARCH_BIG_ID);
const researchRows = researchRowPosts(posts, RESEARCH_BIG_ID).slice(0, 3);
const researchLead =
  "My MA research examines how Canada's largest universities can use communications and storytelling to advance truth and reconciliation and strengthen their relationships with Indigenous partners.";

// 5.5 Speaking & Leadership: latest 3 on the home page.
const speaking = speakingPosts(posts).slice(0, 3);

const monthYear = (d: Date) =>
  d.toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', year: 'numeric' });
const storyFormat = (p: (typeof stories)[number]) => TYPE_LABELS[p.data.types[0]];
---

<BaseLayout
  title="Oliver Mann Studio · Communications Strategist & Photographer"
  description="Oliver Mann is a Vancouver-based communicator, strategist, and storyteller with 15 years leading marketing and communications at UBC. Case studies, research, and creative work."
  active="home"
>
<main>

  <!-- 5.1 Hero: name + typed line only -->
  <section class="hero">
    <h1>Oliver Mann Studio</h1>
    <p class="typed-line">I am a <span class="typed" id="typed">communicator</span></p>
    <div class="about">
      <p>Hi :) I have 15 years of experience leading communications, marketing and events. Where I shine is helping teams and initiatives define their objectives, clearly articulate their impact, and then build the systems and strategies that scale and last.</p>
      <p>The results are that audiences grow. Engagement climbs. Stories resonate. More people take part in programs. Events sell out, again and again. And my favourite part: teams feel, maybe for the first time, that their work is understood and recognized.</p>
    </div>
  </section>

  <!-- 5.2 Featured Case Studies -->
  <section class="fade-in">
    <div class="section-head">
      <h2>Featured Case Studies</h2>
    </div>
    <p class="story" id="cs-story" role="button" tabindex="0" aria-expanded="false">One of the nicest things anyone has said about me is that I’m “educationally <span class="nowrap">magnanimous.”<span class="cue" aria-hidden="true"><span id="cs-typed"></span><span class="caret" id="cs-caret"></span></span></span><span class="rest"> I had to look it up too. She meant that I’m generous with what I know and always happy to teach. I hope this site does the same: beyond showing my work, I want it to be a useful resource for other communicators and marketers.</span></p>
    <div class={featuredRows.length === 0 ? 'split single' : 'split'}>
      {featuredBig && (
        <a class="big-card" href={postHref(featuredBig)}>
          <PostThumb post={featuredBig} placeholder="Hero image to come" widths={[480, 800, 1200]} sizes="(max-width: 820px) 90vw, 600px" />
          <p class="tag">Case Study</p>
          <h3 class="title">{featuredBig.data.title}</h3>
          <p class="date">{longDate(featuredBig.data.date)}</p>
          <p class="excerpt">{featuredBig.data.excerpt}</p>
        </a>
      )}
      {featuredRows.length > 0 && (
        <div class="rows">
          {featuredRows.map((p) => (
            <a class="row-card" href={postHref(p)}>
              <PostThumb post={p} placeholder="Image to come" widths={[240, 480]} sizes="120px" />
              <div>
                <p class="tag">Case Study</p>
                <h3 class="title">{p.data.title}</h3>
                <p class="date">{longDate(p.data.date)}</p>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
    <div class="view-more-row">
      <a class="view-more" href="/blog/#case-studies">View more case studies &rarr;</a>
    </div>
  </section>

  <!-- 5.3 Storytelling: latest 6 shown, filterable by format -->
  <section class="fade-in">
    <div class="section-head">
      <h2>Storytelling</h2>
    </div>
    <div class="filters" role="tablist" aria-label="Filter stories">
      <button class="active" data-filter="all">All</button>
      <button data-filter="Writing">Writing</button>
      <button data-filter="Podcast">Podcasts</button>
      <button data-filter="Video">Videos</button>
    </div>
    <div class="cards" id="stories">
      {stories.map((p) => (
        <a
          class="card"
          data-format={storyFormat(p)}
          href={postHref(p)}
          target={isExternal(p) ? '_blank' : undefined}
          rel={isExternal(p) ? 'noopener' : undefined}
        >
          <PostThumb post={p} />
          <div class="meta">
            <span>{storyFormat(p)}</span>
            <span class="date">{shortDate(p.data.date)}</span>
            {isExternal(p) && <span class="out">&#8599;</span>}
          </div>
          <h3 class="title">{p.data.title}</h3>
          <p class="excerpt">{p.data.excerpt}</p>
        </a>
      ))}
    </div>
    <div class="view-more-row">
      <a class="view-more" href="/blog/#storytelling">View more stories &rarr;</a>
    </div>
  </section>

  <!-- 5.4 Research & Indigenous Engagement -->
  <section class="fade-in">
    <div class="section-head">
      <h2>Research &amp; Indigenous Engagement</h2>
    </div>
    <div class="split">
      {researchBig && (
        <a class="big-card" href={postHref(researchBig)}>
          <PostThumb post={researchBig} placeholder="Image to come" widths={[480, 800, 1200]} sizes="(max-width: 820px) 90vw, 600px" />
          <p class="tag">Research</p>
          <h3 class="title">{researchBig.data.title}</h3>
          <p class="lead-copy">{researchLead}</p>
        </a>
      )}
      <div class="rows">
        {researchRows.map((p) => (
          <a
            class="row-card"
            href={postHref(p)}
            target={isExternal(p) ? '_blank' : undefined}
            rel={isExternal(p) ? 'noopener' : undefined}
          >
            <PostThumb post={p} widths={[240, 480]} sizes="120px" />
            <div>
              <p class="tag">
                {TYPE_LABELS[p.data.types[0]]} · {monthYear(p.data.date)}
                {isExternal(p) && <span class="out">&#8599;</span>}
              </p>
              <h3 class="title">{p.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
    <div class="view-more-row">
      <a class="view-more" href="/blog/#research">View more &rarr;</a>
    </div>
  </section>

  <!-- 5.5 Speaking & Leadership -->
  <section class="fade-in">
    <div class="section-head">
      <h2>Speaking &amp; Leadership</h2>
    </div>
    <div class="cards">
      {speaking.map((p) => (
        <a
          class="card"
          href={postHref(p)}
          target={isExternal(p) ? '_blank' : undefined}
          rel={isExternal(p) ? 'noopener' : undefined}
        >
          <PostThumb post={p} />
          <div class="meta">
            {p.data.role && <span>{p.data.role}</span>}
            <span class="date">{p.data.date.getUTCFullYear()}</span>
            {isExternal(p) && <span class="out">&#8599;</span>}
          </div>
          <h3 class="title">{p.data.title}</h3>
          <p class="excerpt">{p.data.excerpt}</p>
        </a>
      ))}
    </div>
    <div class="view-more-row">
      <a class="view-more" href="/blog/#speaking">View more &rarr;</a>
    </div>
  </section>

</main>
</BaseLayout>

<style>
  main { max-width: 1160px; margin: 0 auto; padding: 0 clamp(24px, 6vw, 80px); }
  section { margin-top: clamp(64px, 10vh, 104px); }
  .hero { margin-top: clamp(28px, 5vh, 48px); text-align: center; }
  .hero h1 { font-weight: 800; font-size: clamp(32px, 4.6vw, 46px); letter-spacing: -0.02em; }
  .hero .typed-line { margin-top: 18px; font-size: clamp(20px, 2.6vw, 28px); font-weight: 500; min-height: 1.5em; }
  /* Fixed-width slot keeps "I am a" from shifting while the centered line types. */
  .hero .typed { font-weight: 800; display: inline-block; min-width: 6.6em; text-align: left; }
  .hero .typed::after { content: ''; display: inline-block; width: 2px; height: 1em; background: var(--text); margin-left: 3px; vertical-align: -0.12em; }
  @media (prefers-reduced-motion: reduce) {
    .hero .typed::after { display: none; }
  }

  /* About intro: same 14.5px muted paragraph style as the Photography intro. */
  .about { max-width: 820px; margin: 18px auto 0; text-align: left; }
  .about p { font-size: 14.5px; line-height: 1.7; color: var(--muted); }
  .about p + p { margin-top: 14px; }

  /* Case studies story line: looping typed "Read more" cue opens the rest inline (same pattern as Photography). */
  .story { max-width: 820px; margin: -14px 0 32px; font-size: 14.5px; line-height: 1.7; color: var(--muted); cursor: pointer; text-align: left; }
  .story.open { cursor: default; }
  .nowrap { white-space: nowrap; }
  .cue { display: inline-block; min-width: 5.2em; margin-left: 6px; color: var(--text); font-weight: 500; white-space: nowrap; text-align: left; border-bottom: 1px solid transparent; }
  .story:not(.open) .cue:hover { border-bottom-color: var(--text); }
  .caret { display: inline-block; width: 1.5px; height: 1em; background: var(--text); vertical-align: -2px; margin-left: 1px; animation: caret-blink 0.8s steps(1) infinite; }
  @keyframes caret-blink { 50% { opacity: 0; } }
  .rest { display: none; }
  .story.open .rest { display: inline; animation: story-fade 0.6s ease; }
  .story.open .cue { display: none; }
  @keyframes story-fade { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .caret { animation: none; }
    .story.open .rest { animation: none; }
  }
</style>

<script>
  // ---------- Typed rotating roles (respects prefers-reduced-motion) ----------
  const roles = [
    'communicator',
    'strategist',
    'storyteller',
    'marketer',
    'writer',
    'photographer',
    'videographer',
    'podcaster',
    'researcher',
    'organizer',
  ];
  const typedEl = document.getElementById('typed')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    let wordIdx = 0;
    let charIdx = roles[0].length;
    let deleting = true;
    let pauseUntil = Date.now() + 1600;
    function tick() {
      if (Date.now() < pauseUntil) {
        requestAnimationFrame(tick);
        return;
      }
      if (deleting) {
        charIdx--;
        typedEl.textContent = roles[wordIdx].slice(0, charIdx);
        if (charIdx === 0) {
          deleting = false;
          wordIdx = (wordIdx + 1) % roles.length;
          pauseUntil = Date.now() + 300;
        } else pauseUntil = Date.now() + 40;
      } else {
        charIdx++;
        typedEl.textContent = roles[wordIdx].slice(0, charIdx);
        if (charIdx === roles[wordIdx].length) {
          deleting = true;
          pauseUntil = Date.now() + 1800;
        } else pauseUntil = Date.now() + 70;
      }
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  // ---------- Storytelling: show latest 6 of the active filter ----------
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>('#stories .card')
  );
  function applyStoryFilter(filter: string) {
    let shown = 0;
    cards.forEach((c) => {
      const match = filter === 'all' || c.dataset.format === filter;
      const visible = match && shown < 6;
      c.classList.toggle('hidden', !visible);
      if (visible) shown++;
    });
  }
  applyStoryFilter('all');
  document
    .querySelectorAll<HTMLButtonElement>('.filters button')
    .forEach((btn) => {
      btn.addEventListener('click', () => {
        document
          .querySelectorAll('.filters button')
          .forEach((b) => b.classList.toggle('active', b === btn));
        applyStoryFilter(btn.dataset.filter!);
      });
    });
</script>

<script>
  // Looping typed "Read more" cue; click the line to reveal the rest of the story.
  const csStory = document.getElementById('cs-story')!;
  const csTyped = document.getElementById('cs-typed')!;
  const csCaret = document.getElementById('cs-caret')!;
  const csWord = 'Read more';
  const csReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let csOpen = false;
  const csWait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  async function csLoop() {
    if (csReduce) {
      csTyped.textContent = csWord;
      csCaret.style.display = 'none';
      return;
    }
    while (!csOpen) {
      for (let i = 0; i <= csWord.length && !csOpen; i++) { csTyped.textContent = csWord.slice(0, i); await csWait(90); }
      if (csOpen) break;
      await csWait(1600);
      for (let j = csWord.length; j >= 0 && !csOpen; j--) { csTyped.textContent = csWord.slice(0, j); await csWait(45); }
      await csWait(500);
    }
  }

  function openCsStory() {
    if (csOpen) return;
    csOpen = true;
    csStory.classList.add('open');
    csStory.setAttribute('aria-expanded', 'true');
    csStory.removeAttribute('role');
    csStory.removeAttribute('tabindex');
  }

  csStory.addEventListener('click', openCsStory);
  csStory.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openCsStory(); }
  });
  csLoop();
</script>
