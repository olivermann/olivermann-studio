  // ----- Content intake: draw the fan of arrows from "Submission is reviewed" to each channel -----
  var intake = document.getElementById('intake');
  function drawFan() {
    if (!intake) return;
    var svg = intake.querySelector('svg.fan');
    intake.classList.add('measuring');
    var box = intake.getBoundingClientRect();
    var src = document.getElementById('intake-src').getBoundingClientRect();
    var chs = intake.querySelectorAll('.ch');
    var x0 = src.right - box.left, y0 = src.top + src.height / 2 - box.top;
    var ns = 'http://www.w3.org/2000/svg', out = '';
    svg.setAttribute('viewBox', '0 0 ' + box.width + ' ' + box.height);
    svg.innerHTML = '';
    chs.forEach(function (ch, i) {
      var r = ch.getBoundingClientRect();
      var x1 = r.left - box.left - 3, y1 = r.top + r.height / 2 - box.top;
      var d = (1.55 + i * 0.12).toFixed(2) + 's';
      var hd = (1.55 + i * 0.12 + 0.45).toFixed(2) + 's';
      var ln = document.createElementNS(ns, 'path');
      ln.setAttribute('class', 'ln');
      ln.setAttribute('pathLength', '1');
      var a = Math.atan2(y1 - y0, x1 - x0), L = 10, W = 5;
      var bx = x1 - L * Math.cos(a), by = y1 - L * Math.sin(a);
      ln.setAttribute('d', 'M' + x0 + ' ' + y0 + ' L' + (bx + Math.cos(a)) + ' ' + (by + Math.sin(a)));
      ln.style.setProperty('--d', d);
      var p1 = (bx + W * Math.sin(a)) + ' ' + (by - W * Math.cos(a));
      var p2 = (bx - W * Math.sin(a)) + ' ' + (by + W * Math.cos(a));
      var head = document.createElementNS(ns, 'path');
      head.setAttribute('class', 'hd');
      head.setAttribute('d', 'M' + x1 + ' ' + y1 + ' L' + p1 + ' L' + p2 + ' Z');
      head.style.setProperty('--d', hd);
      svg.appendChild(ln); svg.appendChild(head);
    });
    intake.classList.remove('measuring');
  }
  if (intake) {
    drawFan();
    window.addEventListener('resize', drawFan);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(drawFan);
  }


  // ----- Open and click rate trend charts -----
  var MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov'];
  var SERIES = {
    open:  { name: 'Open rate',  vals: [29.9,35.2,31.0,32.5,23.8,33.4,34.2,38.5,36.8,38.1,39.6], min: 20, max: 45, step: 5, avg: 28.7, dp: 1 },
    click: { name: 'Click rate', vals: [3.0,4.7,3.4,4.0,3.5,3.5,3.4,3.9,3.4,4.9,5.7],             min: 0,  max: 7,  step: 1, avg: 3.2,  dp: 1 }
  };
  document.querySelectorAll('.trend').forEach(function (t) {
    var cfg = SERIES[t.dataset.series], box = t.querySelector('.lc');
    var W = 320, H = 210, L = 34, R = 12, T = 22, B = 24, n = cfg.vals.length;
    var x = function (i) { return L + i * (W - L - R) / (n - 1); };
    var y = function (v) { return T + (cfg.max - v) * (H - T - B) / (cfg.max - cfg.min); };
    var g = '<g class="grid">', labs = '';
