  // ----- Side nav: underline the section being read -----
  var side = document.querySelector('.side-nav');
  if (side) {
    var links = side.querySelectorAll('a'), heads = ['strategy', 'process', 'results'].map(function (id) { return document.getElementById(id); });
    var spy = function () {
      var cur = -1;
