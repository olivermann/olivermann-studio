      g += '<line x1="' + L + '" x2="' + (W - R) + '" y1="' + y(v) + '" y2="' + y(v) + '"/>';
      labs += '<text class="ylab" x="' + (L - 8) + '" y="' + (y(v) + 4) + '" text-anchor="end">' + v + '%</text>';
    }
    g += '</g>';
    MONTHS.forEach(function (m, i) { labs += '<text class="xlab" x="' + x(i) + '" y="' + (H - 6) + '" text-anchor="middle">' + m + '</text>'; });
    var d = cfg.vals.map(function (v, i) { return (i ? 'L' : 'M') + x(i).toFixed(1) + ' ' + y(v).toFixed(1); }).join(' ');
    var dots = cfg.vals.map(function (v, i) { return '<circle class="dot" r="4" cx="' + x(i) + '" cy="' + y(v) + '" style="--d:' + (0.1 + i * 0.13).toFixed(2) + 's"/>'; }).join('');
    var last = cfg.vals[n - 1];
    var svg = '<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="' + cfg.name + ' by month in 2026, from ' + cfg.vals[0] + '% in January to ' + last + '% in November. The 2025 average was ' + cfg.avg + '%.">' +
      g + labs +
      '<line class="avg" x1="' + L + '" x2="' + (W - R) + '" y1="' + y(cfg.avg) + '" y2="' + y(cfg.avg) + '"/>' +
      '<text class="avg-lab" x="' + (W - R) + '" y="' + (y(cfg.avg) + 15) + '" text-anchor="end">2025 average (' + cfg.avg + '%)</text>' +
      '<line class="cross" y1="' + T + '" y2="' + (H - B) + '"/>' +
      '<path class="line" pathLength="1" d="' + d + '"/>' + dots +
      '<text class="end-lab" x="' + x(n - 1) + '" y="' + (y(last) - 10) + '" text-anchor="end">' + last + '%</text>' +
      '<rect class="hit" x="' + (L - 10) + '" y="0" width="' + (W - L - R + 20) + '" height="' + H + '"/>' +
      '</svg><div class="tip"></div>';
    box.innerHTML = svg;
    var s = box.querySelector('svg'), tip = box.querySelector('.tip'), cross = box.querySelector('.cross');
    function show(e) {
      var r = s.getBoundingClientRect(), k = r.width / W;
      var px = (e.clientX - r.left) / k, i = Math.max(0, Math.min(n - 1, Math.round((px - L) / ((W - L - R) / (n - 1)))));
      cross.setAttribute('x1', x(i)); cross.setAttribute('x2', x(i));
      tip.innerHTML = MONTHS[i] + ' 2026 <b>' + cfg.vals[i].toFixed(cfg.dp) + '%</b>';
      tip.style.left = (x(i) * k) + 'px'; tip.style.top = (y(cfg.vals[i]) * k) + 'px';
      box.classList.add('hover');
    }
    s.addEventListener('pointermove', show);
    s.addEventListener('pointerdown', show);
    s.addEventListener('pointerleave', function () { box.classList.remove('hover'); });
  });

  // ----- Count-up for chart values -----
  function countUp(el) {
    var v = parseFloat(el.dataset.v), t0 = null, dur = 1200, delay = parseFloat(el.style.getPropertyValue('--d')) * 1000 || 0;
